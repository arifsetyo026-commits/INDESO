# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env ke git.

# --- MikroTik (RouterOS API) ---
MIKROTIK_HOST=192.168.50.1
MIKROTIK_PORT=8728
MIKROTIK_USER=INDESO
MIKROTIK_PASSWORD=

# --- OLT C-Data (SNMP) ---
OLT_HOST=192.168.2.100
OLT_SNMP_PORT=161
OLT_SNMP_COMMUNITY=public

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Login dashboard (HTTP Basic). Kosongkan semua = tanpa login (tidak disarankan) ---
# Satu akun:
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Atau beberapa akun sekaligus (nama tercatat di log aktivitas), format nama:password,nama:password
# DASHBOARD_USERS=pemilik:password1,kasir:password2,teknisi:password3
