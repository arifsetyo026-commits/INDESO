# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env ke git.

# --- MikroTik (RouterOS API) ---
MIKROTIK_HOST=192.168.50.1
MIKROTIK_PORT=8728
MIKROTIK_USER=INDESO
MIKROTIK_PASSWORD=

# --- OLT C-Data (SNMP) ---
OLT_HOST=192.168.2.100
OLT_SNMP_PORT=161
OLT_SNMP_COMMUNITY=public

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat pribadi owner untuk laporan keuangan bulanan (jangan grup operasional).
# Kirim /id ke bot dari chat owner untuk mengetahuinya. Bisa juga diisi owner dari dashboard.
TELEGRAM_OWNER_CHAT_ID=

# --- Akun login ---
# Akun dikelola dari dashboard: menu Pengaturan -> Pengguna. Pada instalasi baru,
# buka dashboard di browser dan buat akun admin pertama.
# (Peralihan dari versi lama: isian di bawah hanya diimpor SEKALI saat belum ada
# akun di database. Setelah itu boleh dihapus dari .env.)
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# DASHBOARD_USERS=pemilik:password1,kasir:password2
# MITRA_USERS=joko:password-mitra
