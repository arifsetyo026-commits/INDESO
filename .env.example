# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env ke git.

# --- MikroTik (RouterOS API) ---
MIKROTIK_HOST=192.168.50.1
MIKROTIK_PORT=8728
MIKROTIK_USER=INDESO
MIKROTIK_PASSWORD=

# --- OLT C-Data (SNMP) ---
OLT_HOST=192.168.2.100
OLT_SNMP_PORT=161
OLT_SNMP_COMMUNITY=public

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tujuan laporan keuangan bulanan: grup internal owner dan/atau chat pribadi owner
# (jangan grup operasional). Pisahkan koma. Tambahkan bot ke grup lalu kirim /id di sana.
# Bisa juga diisi owner dari dashboard (Pengaturan -> Sistem).
TELEGRAM_OWNER_CHAT_ID=

# --- Akun login ---
# Akun dikelola dari dashboard: menu Pengaturan -> Pengguna. Pada instalasi baru,
# buka dashboard di browser dan buat akun admin pertama.
# (Peralihan dari versi lama: isian di bawah hanya diimpor SEKALI saat belum ada
# akun di database. Setelah itu boleh dihapus dari .env.)
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# DASHBOARD_USERS=pemilik:password1,kasir:password2
# MITRA_USERS=joko:password-mitra

# --- Kendali ONU dari pusat (TR-069 / GenieACS di VPS) — opsional ---
# Kosongkan bila belum memakai server ACS. Panduan lengkap: docs/genieacs.md
# Nilainya dicetak di akhir deploy/genieacs/install.sh.
GENIEACS_URL=
GENIEACS_USER=indeso
GENIEACS_PASS=

# --- Kirim pengaturan TR-069 ke ONU lewat OLT (telnet, C-Data FD16xx) ---
# Login CLI OLT (sama dengan login web OLT). Kosong = fitur mati.
OLT_TELNET_USER=
OLT_TELNET_PASS=
# ACS yang dikirim ke ONU (sama dengan yang diisi teknisi di ONU/OLT)
ACS_ONU_URL=http://10.99.0.1:7547
ACS_ONU_USER=
ACS_ONU_PASS=
# Aktivasi ONU Baru (juga bisa diubah owner di Pengaturan). Port LAN yang diikat ke internet: binding eth <ini> wlan 1,5.
#OLT_BINDING_LAN=3
# Perintah OLT untuk menghapus PPPoE satu ONU (rute Ganti ONU), dengan {port} dan {onu}. Kosong = Ganti ONU menolak
# ONU lama yang PPPoE-nya tersimpan di OLT. Hasilnya selalu dicek ulang dengan show ont ipconfig.
#OLT_HAPUS_PPPOE=
